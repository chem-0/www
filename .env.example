# SMTP credentials for the /contact form (nodemailer).
# Works with any provider — Zoho, Google Workspace, Fastmail, SES, Mailgun, etc.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password-or-app-password

# Where demo requests are delivered.
CONTACT_TO=hello@yourdomain.com

# Optional — the From: address. Defaults to SMTP_USER.
# Most providers reject a From: that isn't an address you own.
# CONTACT_FROM=no-reply@yourdomain.com
